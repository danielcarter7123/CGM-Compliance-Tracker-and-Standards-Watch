# Copy to .env.local for local development, and add the same values in your host's
# environment settings (Vercel: Project > Settings > Environment Variables).

# Public URL of the site, no trailing slash (http://localhost:3000 locally)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase: Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Never expose this key to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Stripe: Developers > API keys, and the Price IDs of your products
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_WATCH_MONTHLY=price_...
STRIPE_PRICE_WATCH_ANNUAL=price_...

# Resend (email): API key and a verified sending address on your domain
RESEND_API_KEY=re_...
DIGEST_FROM="CGM Standards Watch <watch@yourdomain.com>"

# Microsoft Graph for SharePoint evidence (server only). App registration in CGM's tenant with Sites.Selected.
# See docs/EVIDENCE.md.
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=

# Direct Postgres connection, used only to run the one-time tracker import with psql (docs/IMPORT.md)
SUPABASE_DB_URL=

# Shared secret the Monday draft task uses to post drafts to /api/drafts
DRAFTS_API_TOKEN=change-me-to-a-long-random-string

# Signs the unsubscribe links in Watch emails (server only, 24+ random characters). Changing it breaks old links.
EMAIL_LINK_SECRET=
