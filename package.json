{
  "name": "cgm-compliance-platform",
  "version": "0.1.0",
  "private": true,
  "description": "CGM Consulting Group: Standards Watch and Compliance Tracker in one app, with access per client subscription.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "import:pilot": "tsx scripts/import-pilot.ts",
    "test": "node --test tests/rls.test.mjs && tsx --test tests/lib.test.ts tests/import.test.ts",
    "import:library": "tsx scripts/import-library.ts",
    "import:tracker": "tsx scripts/import-tracker.ts",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:env": "tsx scripts/local-env.ts",
    "seed:dev": "tsx scripts/seed-dev.ts"
  },
  "dependencies": {
    "@supabase/ssr": "0.5.2",
    "@supabase/supabase-js": "2.45.4",
    "next": "14.2.35",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "resend": "4.0.1",
    "server-only": "0.0.1",
    "stripe": "17.2.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.2.12",
    "@types/node": "20.16.11",
    "@types/react": "18.3.11",
    "@types/react-dom": "18.3.1",
    "dotenv": "16.4.5",
    "supabase": "2.122.0",
    "tsx": "4.19.1",
    "typescript": "5.6.3"
  },
  "engines": {
    "node": ">=20"
  }
}
